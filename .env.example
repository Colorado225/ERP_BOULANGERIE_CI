# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# Backend API & base de données Neon
# ---------------------------------------------------------------------------
# DATABASE_URL: chaîne de connexion Neon (Postgres serverless).
# À récupérer dans le tableau de bord Neon → Connection Details.
# Format : postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/boulangeriepro?sslmode=require"



# Port d'écoute de l'API backend.
PORT=4000

# Origine autorisée pour le front (CORS).
CORS_ORIGIN="http://localhost:3000"

# ---------------------------------------------------------------------------
# Mobile Money Côte d'Ivoire - Clés API
# ---------------------------------------------------------------------------
# VITE_WAVE_API_KEY: Clé API pour Wave Côte d'Ivoire (production)
VITE_WAVE_API_KEY="VOTRE_CLE_WAVE_PRODUCTION"

# VITE_OM_API_KEY: Clé API pour Orange Money Côte d'Ivoire (production)
VITE_OM_API_KEY="VOTRE_CLE_OM_PRODUCTION"

# VITE_MTN_API_KEY: Clé API pour MTN MoMo Côte d'Ivoire (production)
VITE_MTN_API_KEY="VOTRE_CLE_MTN_PRODUCTION"

# URLs des APIs production des opérateurs
VITE_WAVE_API_URL="https://api.wave.com/api"
VITE_OM_API_URL="https://api.orange.com/orange-money"
VITE_MTN_API_URL="https://momodeveloper.mtn.com/collection/v1_0"

# Clés de vérification des signatures webhooks (à récupérer dans vos tableaux de bord opérateurs)
WAVE_WEBHOOK_SECRET="VOTRE_SECRET_WAVE_WEBHOOK"
ORANGE_MONEY_WEBHOOK_SECRET="VOTRE_SECRET_OM_WEBHOOK"
MTN_MOMO_WEBHOOK_SECRET="VOTRE_SECRET_MTN_WEBHOOK"

# URLs des webhooks à configurer dans les tableaux de bord des opérateurs :
# 🌐 Wave: https://votre-domaine.com/api/webhooks/mobilemoney?operator=WAVE
# 🌐 Orange Money: https://votre-domaine.com/api/webhooks/mobilemoney?operator=ORANGE
# 🌐 MTN MoMo: https://votre-domaine.com/api/webhooks/mobilemoney?operator=MTN
# En local (sandbox) : http://localhost:4000/api/webhooks/mobilemoney?operator=XXX