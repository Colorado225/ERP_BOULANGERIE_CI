# --- Serveur API -------------------------------------------------------------
# Obligatoire en production.
DATABASE_URL=
# URL de base Neon Auth (tableau de bord Neon > Auth), sans slash final.
# Exemple : https://ep-xxx.neonauth.<région>.aws.neon.tech/neondb/auth
NEON_AUTH_BASE_URL=
# Émetteur attendu des jetons (optionnel). Par défaut : origine de NEON_AUTH_BASE_URL.
NEON_AUTH_ISSUER=
CORS_ORIGIN=
# Secrets de vérification des webhooks Mobile Money (obligatoires en production).
WAVE_WEBHOOK_SECRET=
ORANGE_MONEY_WEBHOOK_SECRET=
MTN_MOMO_WEBHOOK_SECRET=
GEMINI_API_KEY=

# --- Front (Vite) : valeurs publiques, visibles dans le navigateur ------------
# URL de base Neon Auth, identique à NEON_AUTH_BASE_URL.
VITE_NEON_AUTH_URL=
VITE_MTN_API_KEY=
VITE_MTN_API_URL=
VITE_OM_API_KEY=
VITE_OM_API_URL=
VITE_WAVE_API_KEY=
VITE_WAVE_API_URL=
